# Copy to .env and fill in. Never commit .env.

# Postgres in production. Leave unset locally to use a SQLite file (backend/verdant.db).
# DATABASE_URL=postgresql://verdant:verdant@localhost:5432/verdant

# Together.ai (https://api.together.xyz)
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# HMAC secret the chat platform signs webhooks with
WEBHOOK_SECRET=verdant-demo-secret-2026

# Agent account created on first start (change the password!)
AGENT_SEED_EMAIL=agent@verdant.co
AGENT_SEED_PASSWORD=change-me-please
AGENT_SEED_NAME=Support Agent

# true when served over HTTPS (sends the session cookie with the Secure flag)
COOKIE_SECURE=false
LOG_LEVEL=INFO
